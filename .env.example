# TalentIQ Environment Variables
# Copy to .env and fill in values

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://talentiq:talentiq_secret@localhost:5432/talentiq

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Neo4j (Skills Graph) ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=talentiq_neo4j

# ─── ClickHouse (Analytics) ─────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=talentiq
CLICKHOUSE_PASSWORD=talentiq_ch
CLICKHOUSE_DB=talentiq_analytics

# ─── MinIO (File Storage) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=talentiq
MINIO_SECRET_KEY=talentiq_minio
MINIO_BUCKET_RESUMES=resumes
MINIO_BUCKET_RECORDINGS=recordings

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ─── AI Service (FastAPI) ───────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=talentiq-api

# ─── Blockchain (Credential NFTs) ──────────────────────────
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CREDENTIAL_CONTRACT_ADDRESS=0x...
DEPLOYER_PRIVATE_KEY=0x...

# ─── Prometheus / OpenTelemetry ─────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=talentiq-api

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
ENV=development
PORT=4000
BFF_WEB_PORT=4001

# ─── Redis (individual host/port used by shared pkg) ────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Neo4j service URL ──────────────────────────────────────
NEO4J_SERVICE_URL=bolt://localhost:7687

# ─── Postgres service URL ───────────────────────────────────
POSTGRES_SERVICE_URL=postgresql://talentiq:talentiq_secret@localhost:5432/talentiq

# ─── Web App ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ORG_ID=default-org

# ─── Observability (Jaeger / Tempo) ─────────────────────────
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832
TEMPO_ENDPOINT=http://localhost:4317

# ─── Feature flags / external integrations (orphan clients) ─
# Leave blank to disable; set real values when wiring up.
ARGO_URL=http://localhost:2746
ARGO_TOKEN=
CONSUL_HOST=localhost
CONSUL_PORT=8500
EVIDENTLY_URL=http://localhost:8080
FEAST_URL=http://localhost:6566
HUGGINGFACE_API_KEY=
KUBEFLOW_URL=http://localhost:8080
KUBEFLOW_TOKEN=
MLFLOW_TRACKING_URI=http://localhost:5000
NATS_URL=nats://localhost:4222
PINECONE_API_KEY=
RAY_URL=http://localhost:8265
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=talentiq
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http
WEAVIATE_API_KEY=
