{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
